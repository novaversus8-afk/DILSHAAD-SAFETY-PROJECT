<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dilshaad Safety Project | Invisible Grill & Safety Net</title>

<style>
*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  font-family:Arial,Helvetica,sans-serif;
  background:#f4f7fb;
  color:#17233b;
}

a{
  text-decoration:none;
}

button,
input,
textarea{
  font-family:inherit;
}

header{
  background:#07152e;
  color:white;
  position:sticky;
  top:0;
  z-index:1000;
  box-shadow:0 3px 15px #0004;
}

.nav{
  max-width:1250px;
  margin:auto;
  padding:10px 15px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
}

.brand{
  display:flex;
  align-items:center;
  gap:10px;
  font-weight:bold;
}

.logo{
  width:52px;
  height:52px;
  border-radius:50%;
  background:white;
  object-fit:cover;
  border:2px solid white;
}

.brand-title{
  font-size:17px;
}

.brand-sub{
  font-size:11px;
  color:#cbd5e1;
  margin-top:3px;
}

.actions{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
}

.btn{
  display:inline-block;
  border:0;
  border-radius:8px;
  padding:11px 15px;
  font-weight:bold;
  cursor:pointer;
}

.call{
  background:#16a34a;
  color:white;
}

.whatsapp{
  background:#22c55e;
  color:white;
}

.admin-btn{
  background:#2563eb;
  color:white;
}

.map-btn{
  background:white;
  color:#14213d;
}

.hero{
  min-height:570px;
  display:flex;
  align-items:center;
  color:white;
  background:
    linear-gradient(90deg,#041128ee,#04112888,#04112822),
    url("https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1800&q=90")
    center/cover no-repeat;
}

.container{
  max-width:1250px;
  width:100%;
  margin:auto;
  padding:20px;
}

.hero-content{
  max-width:760px;
}

.hero-tag{
  display:inline-block;
  padding:8px 13px;
  background:#2563eb;
  border-radius:30px;
  font-size:13px;
  font-weight:bold;
}

.hero h1{
  font-size:clamp(38px,6vw,70px);
  line-height:1.05;
  margin:18px 0;
}

.hero p{
  font-size:19px;
  line-height:1.7;
  color:#e5e7eb;
}

.hero-buttons{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-top:25px;
}

section{
  padding:60px 0;
}

.section-title{
  text-align:center;
  font-size:34px;
  margin:0 0 10px;
}

.section-sub{
  text-align:center;
  color:#64748b;
  margin:0 auto 35px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:22px;
}

.card{
  background:white;
  border-radius:17px;
  overflow:hidden;
  border:1px solid #dbe3ef;
  box-shadow:0 8px 25px #13233b12;
  transition:.2s;
}

.card:hover{
  transform:translateY(-4px);
  box-shadow:0 15px 35px #13233b20;
}

.card img{
  width:100%;
  height:270px;
  display:block;
  object-fit:cover;
}

.card-body{
  padding:20px;
}

.card h3{
  margin:0 0 10px;
  font-size:21px;
}

.card p{
  color:#64748b;
  line-height:1.6;
  min-height:50px;
}

.features{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:18px;
}

.feature{
  background:white;
  border:1px solid #dbe3ef;
  border-radius:16px;
  padding:25px 18px;
  text-align:center;
}

.feature-icon{
  font-size:38px;
}

.feature h3{
  margin:12px 0 7px;
}

.feature p{
  color:#64748b;
  line-height:1.5;
  font-size:14px;
}

.gallery{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:20px;
}

.gallery-item{
  background:white;
  border-radius:17px;
  overflow:hidden;
  border:1px solid #dbe3ef;
  box-shadow:0 8px 25px #13233b12;
}

.gallery-item img{
  width:100%;
  height:380px;
  display:block;
  object-fit:cover;
}

.gallery-caption{
  padding:15px;
  font-weight:bold;
}

.contact{
  background:#07152e;
  color:white;
}

.contact-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:25px;
}

.contact-box{
  background:#ffffff0d;
  border:1px solid #ffffff20;
  border-radius:18px;
  padding:28px;
}

.contact-box h2{
  margin-top:0;
}

.contact-row{
  padding:12px 0;
  border-bottom:1px solid #ffffff18;
  line-height:1.5;
}

.contact-row a{
  color:white;
}

.map{
  width:100%;
  height:380px;
  border:0;
  border-radius:14px;
}

footer{
  background:#030914;
  color:#aebbd0;
  text-align:center;
  padding:25px 15px;
}

/* ADMIN */

.hidden{
  display:none !important;
}

#adminPage{
  min-height:100vh;
  background:#eef3f9;
  padding-bottom:50px;
}

.admin-header{
  background:#07152e;
  color:white;
  padding:18px;
}

.admin-header-inner{
  max-width:1200px;
  margin:auto;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.admin-container{
  max-width:1200px;
  margin:auto;
  padding:25px 15px;
}

.panel{
  background:white;
  border:1px solid #dbe3ef;
  border-radius:17px;
  padding:22px;
  margin-bottom:20px;
  box-shadow:0 5px 20px #13233b0b;
}

.panel h2{
  margin-top:0;
}

.row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:15px;
}

label{
  display:block;
  font-weight:bold;
  margin:8px 0 6px;
}

input,
textarea{
  width:100%;
  padding:12px;
  border:1px solid #cbd5e1;
  border-radius:9px;
  outline:none;
  background:white;
}

textarea{
  min-height:95px;
  resize:vertical;
}

input:focus,
textarea:focus{
  border-color:#2563eb;
}

.save-btn{
  background:#2563eb;
  color:white;
}

.service-admin{
  display:grid;
  grid-template-columns:180px 1fr;
  gap:20px;
  padding:20px 0;
  border-top:1px solid #e5e7eb;
}

.service-admin:first-child{
  border-top:0;
}

.service-admin img{
  width:180px;
  height:130px;
  object-fit:cover;
  border-radius:12px;
  border:1px solid #dbe3ef;
}

.modal{
  position:fixed;
  inset:0;
  background:#000b;
  display:none;
  align-items:center;
  justify-content:center;
  padding:15px;
  z-index:5000;
}

.modal.show{
  display:flex;
}

.login-box{
  width:min(420px,100%);
  background:white;
  border-radius:18px;
  padding:25px;
}

.login-box h2{
  margin-top:0;
}

.login-box button{
  width:100%;
  margin-top:10px;
}

.small-note{
  color:#64748b;
  font-size:13px;
  line-height:1.5;
}

.toast{
  position:fixed;
  right:18px;
  bottom:18px;
  background:#111827;
  color:white;
  padding:14px 18px;
  border-radius:10px;
  z-index:9000;
  display:none;
}

.toast.show{
  display:block;
}

@media(max-width:900px){
  .grid{
    grid-template-columns:1fr 1fr;
  }

  .features{
    grid-template-columns:1fr 1fr;
  }

  .contact-grid{
    grid-template-columns:1fr;
  }
}

@media(max-width:600px){
  .nav{
    align-items:flex-start;
  }

  .brand-sub{
    display:none;
  }

  .brand-title{
    font-size:14px;
  }

  .logo{
    width:43px;
    height:43px;
  }

  .actions .btn{
    padding:8px 9px;
    font-size:11px;
  }

  .hero{
    min-height:510px;
  }

  .hero h1{
    font-size:42px;
  }

  .hero p{
    font-size:15px;
  }

  .grid,
  .features,
  .gallery{
    grid-template-columns:1fr;
  }

  .gallery-item img{
    height:300px;
  }

  .row{
    grid-template-columns:1fr;
  }

  .service-admin{
    grid-template-columns:1fr;
  }

  .service-admin img{
    width:100%;
    height:230px;
  }
}
</style>
</head>

<body>

<!-- ================= CUSTOMER WEBSITE ================= -->

<div id="customerPage">

<header id="mainHeader">
  <div class="nav">

    <div class="brand">
      <img
        class="logo"
        id="customerLogo"
        src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=500&q=80"
        alt="Dilshaad Safety Project">

      <div>
        <div class="brand-title" id="navBusinessName">
          Dilshaad Safety Project
        </div>

        <div class="brand-sub">
          Invisible Grill • Safety Net • All Types of Nets
        </div>
      </div>
    </div>

    <div class="actions">
      <a class="btn call" id="navCall">📞 7209000233</a>
      <a class="btn whatsapp" id="navWhatsapp" target="_blank">💬 WhatsApp</a>
      <button class="btn admin-btn" onclick="openLogin()">🔐 Admin</button>
    </div>

  </div>
</header>


<section class="hero">

  <div class="container hero-content">

    <span class="hero-tag">
      PROFESSIONAL SAFETY & NET SOLUTIONS
    </span>

    <h1 id="heroBusinessName">
      Dilshaad Safety Project
    </h1>

    <p>
      Balcony, windows और open areas के लिए premium
      Invisible Grill, Safety Net, Pigeon Net, Bird Net,
      Child Safety Net, Mosquito Net और Cricket Sports Net.
    </p>

    <div class="hero-buttons">

      <a class="btn call" id="heroCall">
        📞 Contact Now
      </a>

      <a class="btn whatsapp" id="heroWhatsapp" target="_blank">
        💬 WhatsApp Quote
      </a>

      <a class="btn map-btn" id="heroMap" target="_blank">
        📍 Google Maps
      </a>

    </div>

  </div>

</section>


<!-- SERVICES -->

<section>

  <div class="container">

    <h2 class="section-title">
      हमारी Services
    </h2>

    <p class="section-sub">
      Home, Balcony, Window और Commercial Safety के लिए solutions
    </p>

    <div id="servicesGrid" class="grid"></div>

  </div>

</section>


<!-- GALLERY -->

<section style="background:#eaf0f7">

  <div class="container">

    <h2 class="section-title">
      Our Work Gallery
    </h2>

    <p class="section-sub">
      Invisible Grill और Safety Net के real-looking project photos
    </p>

    <div id="galleryGrid" class="gallery"></div>

  </div>

</section>


<!-- WHY US -->

<section>

  <div class="container">

    <h2 class="section-title">
      क्यों हमें चुनें?
    </h2>

    <p class="section-sub">
      Quality और professional installation
    </p>

    <div class="features">

      <div class="feature">
        <div class="feature-icon">🛡️</div>
        <h3>Safety First</h3>
        <p>
          Family और property के लिए safety-focused solutions.
        </p>
      </div>

      <div class="feature">
        <div class="feature-icon">📏</div>
        <h3>Accurate Measurement</h3>
        <p>
          Area के हिसाब से proper measurement और quotation.
        </p>
      </div>

      <div class="feature">
        <div class="feature-icon">🔧</div>
        <h3>Professional Work</h3>
        <p>
          Clean और professional installation service.
        </p>
      </div>

      <div class="feature">
        <div class="feature-icon">💰</div>
        <h3>Transparent Price</h3>
        <p>
          Quantity, rate और total quotation साफ तरीके से.
        </p>
      </div>

    </div>

  </div>

</section>


<!-- CONTACT -->

<section class="contact">

  <div class="container contact-grid">

    <div class="contact-box">

      <h2>
        Business Details
      </h2>

      <div class="contact-row">
        🏢 <b id="contactBusinessName">
          Dilshaad Safety Project
        </b>
      </div>

      <div class="contact-row">
        📞
        <a id="contactPhone">
          7209000233
        </a>
      </div>

      <div class="contact-row">
        💬
        <a id="contactWhatsapp" target="_blank">
          WhatsApp
        </a>
      </div>

      <div class="contact-row">
        ✉️
        <span id="contactEmail">
          d.s.safetyprojects7484@gmail.com
        </span>
      </div>

      <div class="contact-row">
        📍
        <span id="contactAddress">
          Sector 11, Taloja, Navi Mumbai,
          Maharashtra - 410208, India
        </span>
      </div>

      <br>

      <a class="btn call" id="contactCall">
        📞 Call Now
      </a>

      <a class="btn whatsapp" id="contactWhatsappButton" target="_blank">
        💬 WhatsApp
      </a>

      <a class="btn map-btn" id="contactMap" target="_blank">
        📍 Open Map
      </a>

    </div>


    <div class="contact-box">

      <h2>
        हमारा Location
      </h2>

      <iframe
        id="mapFrame"
        class="map"
        loading="lazy">
      </iframe>

    </div>

  </div>

</section>


<footer>
  © <span id="year"></span>
  Dilshaad Safety Project.
  All Rights Reserved.
</footer>

</div>


<!-- ================= ADMIN DASHBOARD ================= -->

<div id="adminPage" class="hidden">

  <div class="admin-header">

    <div class="admin-header-inner">

      <div>
        <b>🔐 Dilshaad Safety Project</b>
        <br>
        <small>Admin Dashboard</small>
      </div>

      <button class="btn" style="background:#dc2626;color:white"
              onclick="logout()">
        Logout
      </button>

    </div>

  </div>


  <div class="admin-container">

    <div class="panel">

      <h2>
        🏢 Business Details
      </h2>

      <div class="row">

        <div>
          <label>Business Name</label>
          <input id="adminName">
        </div>

        <div>
          <label>Contact Number</label>
          <input id="adminPhone">
        </div>

      </div>


      <div class="row">

        <div>
          <label>WhatsApp Number</label>
          <input id="adminWhatsapp">
        </div>

        <div>
          <label>Email</label>
          <input id="adminEmail">
        </div>

      </div>


      <label>
        Business Address
      </label>

      <textarea id="adminAddress"></textarea>


      <label>
        Google Maps Location Link
      </label>

      <input id="adminMap">


      <label>
        Business Logo / Photo
      </label>

      <input
        type="file"
        id="logoUpload"
        accept="image/*"
        onchange="changeLogo(event)">

      <br><br>

      <img
        id="adminLogoPreview"
        style="width:100px;height:100px;object-fit:cover;border-radius:50%;border:2px solid #ddd">

      <br><br>

      <button class="btn save-btn"
              onclick="saveBusiness()">
        💾 Save Business Details
      </button>

    </div>


    <div class="panel">

      <h2>
        🖼️ Services & Photos
      </h2>

      <p class="small-note">
        यहाँ से किसी भी service की photo बदल सकते हैं।
        Photo बदलने के बाद Save Service दबाएँ।
      </p>

      <div id="adminServices"></div>

    </div>


    <div class="panel">

      <h2>
        ℹ️ Website Information
      </h2>

      <p class="small-note">
        Customer को केवल main website दिखाई देगी।
        Admin Dashboard password के बिना सामान्य customer page पर दिखाई नहीं देता।
      </p>

      <p class="small-note">
        इस version में Firebase नहीं है। Business details,
        logo और service photos इसी browser के Local Storage में save होते हैं।
      </p>

    </div>

  </div>

</div>


<!-- LOGIN -->

<div id="loginModal" class="modal">

  <div class="login-box">

    <h2>
      🔐 Admin Login
    </h2>

    <p class="small-note">
      केवल business owner के लिए।
    </p>

    <label>
      Admin Password
    </label>

    <input
      id="loginPassword"
      type="password"
      placeholder="Password">

    <button
      class="btn admin-btn"
      onclick="login()">
      Login
    </button>

    <button
      class="btn"
      style="background:#e5e7eb;width:100%;margin-top:8px"
      onclick="closeLogin()">
      Cancel
    </button>

    <p class="small-note">
      Default password: <b>1234</b>
    </p>

  </div>

</div>


<div id="toast" class="toast"></div>


<script>

/* =========================================================
   ADMIN PASSWORD
   ========================================================= */

const ADMIN_PASSWORD = "1234";


/* =========================================================
   DEFAULT BUSINESS DETAILS
   ========================================================= */

const defaultBusiness = {

  name: "Dilshaad Safety Project",

  phone: "7209000233",

  whatsapp: "7209000233",

  email: "d.s.safetyprojects7484@gmail.com",

  address:
  "Sector 11, Taloja, Navi Mumbai, Maharashtra - 410208, India",

  map:
  "https://www.google.com/maps/search/?api=1&query=Sector+11%2C+Taloja%2C+Navi+Mumbai%2C+Maharashtra+410208"

};


/* =========================================================
   PHOTOS
   ========================================================= */

const defaultPhotos = {

  hero:
  "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1800&q=90",

  grill:
  "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=90",

  safety:
  "https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1200&q=90",

  pigeon:
  "https://images.unsplash.com/photo-1600607688969-a5bfcd646154?auto=format&fit=crop&w=1200&q=90"

};


/* =========================================================
   LOAD SAVED DATA
   ========================================================= */

let business =
  JSON.parse(localStorage.getItem("dsp_business")) ||
  defaultBusiness;


let photos =
  JSON.parse(localStorage.getItem("dsp_photos")) ||
  defaultPhotos;


/* =========================================================
   SERVICES
   ========================================================= */

let services = [

  {
    name:"Invisible Grill",
    description:
    "Balcony और windows के लिए premium stainless-steel invisible grill.",
    image:photos.grill
  },

  {
    name:"Safety Net",
    description:
    "Balcony और open areas के लिए strong safety net.",
    image:photos.safety
  },

  {
    name:"Pigeon Safety Net",
    description:
    "Balcony को pigeons और unwanted birds से बचाने के लिए.",
    image:photos.pigeon
  },

  {
    name:"Balcony Net",
    description:
    "Balcony और open areas के लिए durable protective net.",
    image:photos.safety
  },

  {
    name:"Child Safety Net",
    description:
    "High-rise balcony और open spaces के लिए child safety.",
    image:photos.safety
  },

  {
    name:"Window Invisible Grill",
    description:
    "Windows के लिए clear-view invisible grill.",
    image:photos.grill
  },

  {
    name:"Cricket Sports Net",
    description:
    "Cricket practice और sports areas के लिए net solutions.",
    image:photos.safety
  },

  {
    name:"Bird Net",
    description:
    "Bird protection के लिए strong और durable net.",
    image:photos.pigeon
  },

  {
    name:"Mosquito Net",
    description:
    "Windows और ventilation areas के लिए mosquito protection.",
    image:photos.grill
  }

];


try{

  const savedServices =
    JSON.parse(localStorage.getItem("dsp_services"));

  if(
    Array.isArray(savedServices) &&
    savedServices.length > 0
  ){

    services = savedServices;

  }

}catch(error){

  console.log(error);

}


/* =========================================================
   SAVE EVERYTHING
   ========================================================= */

function saveAll(){

  localStorage.setItem(
    "dsp_business",
    JSON.stringify(business)
  );

  localStorage.setItem(
    "dsp_photos",
    JSON.stringify(photos)
  );

  localStorage.setItem(
    "dsp_services",
    JSON.stringify(services)
  );

}


/* =========================================================
   WHATSAPP LINK
   ========================================================= */

function whatsappLink(message){

  let number =
    business.whatsapp
    .replace(/\D/g,"");

  if(number.length === 10){

    number = "91" + number;

  }

  return(
    "https://wa.me/" +
    number +
    "?text=" +
    encodeURIComponent(message)
  );

}


/* =========================================================
   APPLY BUSINESS DETAILS
   ========================================================= */

function applyBusiness(){

  document.getElementById(
    "navBusinessName"
  ).textContent = business.name;

  document.getElementById(
    "heroBusinessName"
  ).textContent = business.name;

  document.getElementById(
    "contactBusinessName"
  ).textContent = business.name;

  document.getElementById(
    "contactPhone"
  ).textContent = business.phone;

  document.getElementById(
    "contactEmail"
  ).textContent = business.email;

  document.getElementById(
    "contactAddress"
  ).textContent = business.address;


  const tel =
    "tel:" +
    business.phone.replace(/\D/g,"");


  document.getElementById(
    "navCall"
  ).href = tel;

  document.getElementById(
    "heroCall"
  ).href = tel;

  document.getElementById(
    "contactCall"
  ).href = tel;


  const wa =
    whatsappLink(
      "Hello, मुझे " +
      business.name +
      " से quotation चाहिए।"
    );


  document.getElementById(
    "navWhatsapp"
  ).href = wa;

  document.getElementById(
    "heroWhatsapp"
  ).href = wa;

  document.getElementById(
    "contactWhatsapp"
  ).href = wa;

  document.getElementById(
    "contactWhatsappButton"
  ).href = wa;


  document.getElementById(
    "heroMap"
  ).href = business.map;

  document.getElementById(
    "contactMap"
  ).href = business.map;


  document.getElementById(
    "mapFrame"
  ).src =
  "https://www.google.com/maps?q=" +
  encodeURIComponent(business.address) +
  "&output=embed";


  document.getElementById(
    "customerLogo"
  ).src =
  photos.logo ||
  photos.grill;

}


/* =========================================================
   RENDER SERVICES
   ========================================================= */

function renderServices(){

  const grid =
    document.getElementById("servicesGrid");

  grid.innerHTML = "";


  services.forEach((service,index)=>{

    grid.innerHTML += `

      <article class="card">

        <img
          src="${service.image}"
          alt="${service.name}"
          loading="lazy">

        <div class="card-body">

          <h3>
            ${service.name}
          </h3>

          <p>
            ${service.description}
          </p>

          <a
            class="btn admin-btn"
            target="_blank"
            href="${whatsappLink(
              "Hello, मुझे " +
              service.name +
              " का quotation चाहिए।"
            )}">

            Get Quote

          </a>

        </div>

      </article>

    `;

  });

}


/* =========================================================
   RENDER GALLERY
   ========================================================= */

function renderGallery(){

  const gallery =
    document.getElementById("galleryGrid");

  gallery.innerHTML = "";


  const galleryData = [

    {
      image:photos.hero,
      title:"Premium Balcony Project"
    },

    {
      image:photos.grill,
      title:"Invisible Grill Project"
    },

    {
      image:photos.safety,
      title:"Safety Net Project"
    },

    {
      image:photos.pigeon,
      title:"Balcony / Pigeon Net Project"
    }

  ];


  galleryData.forEach(item=>{

    gallery.innerHTML += `

      <div class="gallery-item">

        <img
          src="${item.image}"
          alt="${item.title}"
          loading="lazy">

        <div class="gallery-caption">
          ${item.title}
        </div>

      </div>

    `;

  });

}


/* =========================================================
   ADMIN LOGIN
   ========================================================= */

function openLogin(){

  document
  .getElementById("loginModal")
  .classList.add("show");

  document
  .getElementById("loginPassword")
  .focus();

}


function closeLogin(){

  document
  .getElementById("loginModal")
  .classList.remove("show");

}


function login(){

  const password =
    document.getElementById(
      "loginPassword"
    ).value;


  if(password === ADMIN_PASSWORD){

    closeLogin();

    document
    .getElementById("customerPage")
    .classList.add("hidden");

    document
    .getElementById("adminPage")
    .classList.remove("hidden");

    fillAdmin();

  }else{

    alert("❌ Admin Password गलत है");

  }

}


function logout(){

  document
  .getElementById("adminPage")
  .classList.add("hidden");

  document
  .getElementById("customerPage")
  .classList.remove("hidden");

}


/* =========================================================
   FILL ADMIN DASHBOARD
   ========================================================= */

function fillAdmin(){

  document.getElementById(
    "adminName"
  ).value = business.name;

  document.getElementById(
    "adminPhone"
  ).value = business.phone;

  document.getElementById(
    "adminWhatsapp"
  ).value = business.whatsapp;

  document.getElementById(
    "adminEmail"
  ).value = business.email;

  document.getElementById(
    "adminAddress"
  ).value = business.address;

  document.getElementById(
    "adminMap"
  ).value = business.map;


  document.getElementById(
    "adminLogoPreview"
  ).src =
  photos.logo ||
  photos.grill;


  renderAdminServices();

}


/* =========================================================
   SAVE BUSINESS
   ========================================================= */

function saveBusiness(){

  business = {

    name:
    document.getElementById(
      "adminName"
    ).value.trim(),

    phone:
    document.getElementById(
      "adminPhone"
    ).value.trim(),

    whatsapp:
    document.getElementById(
      "adminWhatsapp"
    ).value.trim(),

    email:
    document.getElementById(
      "adminEmail"
    ).value.trim(),

    address:
    document.getElementById(
      "adminAddress"
    ).value.trim(),

    map:
    document.getElementById(
      "adminMap"
    ).value.trim()

  };


  if(!business.name){

    business.name =
    "Dilshaad Safety Project";

  }


  saveAll();

  applyBusiness();

  showToast(
    "✅ Business Details Successfully Saved"
  );

}


/* =========================================================
   LOGO UPLOAD
   ========================================================= */

function changeLogo(event){

  const file =
    event.target.files[0];

  if(!file) return;


  const reader =
    new FileReader();


  reader.onload = function(){

    photos.logo =
      reader.result;

    document.getElementById(
      "adminLogoPreview"
    ).src =
    photos.logo;

    saveAll();

    applyBusiness();

    showToast(
      "✅ Logo Saved"
    );

  };


  reader.readAsDataURL(file);

}


/* =========================================================
   ADMIN SERVICE LIST
   ========================================================= */

function renderAdminServices(){

  const box =
    document.getElementById(
      "adminServices"
    );

  box.innerHTML = "";


  services.forEach((service,index)=>{

    box.innerHTML += `

      <div class="service-admin">

        <img
          id="preview-${index}"
          src="${service.image}"
          alt="${service.name}">

        <div>

          <h3>
            ${service.name}
          </h3>

          <label>
            Service Description
          </label>

          <input
            id="description-${index}"
            value="${escapeHTML(service.description)}">


          <label>
            नई Photo Upload करें
          </label>

          <input
            type="file"
            accept="image/*"
            onchange="uploadServicePhoto(event,${index})">


          <br><br>

          <button
            class="btn save-btn"
            onclick="saveService(${index})">

            💾 Save Service

          </button>

        </div>

      </div>

    `;

  });

}


/* =========================================================
   ESCAPE HTML
   ========================================================= */

function escapeHTML(text){

  return String(text)
  .replace(/&/g,"&amp;")
  .replace(/</g,"&lt;")
  .replace(/>/g,"&gt;")
  .replace(/"/g,"&quot;")
  .replace(/'/g,"&#039;");

}


/* =========================================================
   SERVICE PHOTO UPLOAD
   ========================================================= */

function uploadServicePhoto(event,index){

  const file =
    event.target.files[0];

  if(!file) return;


  const reader =
    new FileReader();


  reader.onload=function(){

    services[index].image =
      reader.result;

    document.getElementById(
      "preview-"+index
    ).src =
    reader.result;

  };


  reader.readAsDataURL(file);

}


/* =========================================================
   SAVE SERVICE
   ========================================================= */

function saveService(index){

  const description =
    document.getElementById(
      "description-"+index
    ).value;


  services[index].description =
    description;


  saveAll();

  renderServices();

  renderGallery();

  showToast(
    "✅ Service Details & Photo Saved"
  );

}


/* =========================================================
   TOAST
   ========================================================= */

function showToast(message){

  const toast =
    document.getElementById("toast");

  toast.textContent =
    message;

  toast.classList.add("show");


  setTimeout(()=>{

    toast.classList.remove("show");

  },2500);

}


/* =========================================================
   INITIALIZE
   ========================================================= */

document.getElementById(
  "year"
).textContent =
new Date().getFullYear();


applyBusiness();

renderServices();

renderGallery();


/* ENTER KEY LOGIN */

document
.getElementById("loginPassword")
.addEventListener("keydown",function(e){

  if(e.key === "Enter"){

    login();

  }

});

</script>

</body>
</html>
